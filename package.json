{
  "name": "dsh-model-tidy",
  "version": "0.0.3",
  "description": "DeepSeek Harness plugin: keep the model selector tidy. Choose which models appear and what they are called, without touching any provider configuration or running session.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md",
    "README.ja.md",
    "README.ru.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/rate.test.mjs && node test/client.test.mjs && node test/alias-suffix.test.mjs && node test/order.test.mjs && node test/sort.test.mjs && node test/sort-render.test.mjs && node test/render.test.mjs && node test/coexistence.test.mjs",
    "check:packaging": "node .market/check-client-inject.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "model",
    "model-list",
    "alias",
    "rename",
    "visibility",
    "selector"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/star-Cosmo/dsh-model-tidy.git"
  },
  "homepage": "https://github.com/star-Cosmo/dsh-model-tidy#readme",
  "bugs": {
    "url": "https://github.com/star-Cosmo/dsh-model-tidy/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
